# =============================================================================
# ETP - Enterprise Trading Platform: environment configuration
#
# Copy this file to .env (same folder, the repository root) and fill in the blank values.
# .env is never committed. This file lists EVERY variable the platform reads, so
# .env and .env.example must always contain the same keys (npm run validate:config checks it).
# Service endpoints follow the deployment PDF: frontend 4200, auth 3000, order 8081,
# executor 8082, PostgreSQL 5432 (trading_system_db), Kafka kafka:29092 on the Docker network.
# =============================================================================

# --- Frontend (Angular) ------------------------------------------------------
FRONTEND_URL=http://localhost
FRONTEND_PORT=4200

# --- Auth service (NestJS) ---------------------------------------------------
AUTH_SERVICE_URL=http://localhost
AUTH_SERVICE_PORT=3000

# --- Order service (Spring Boot, services/trade-api) -------------------------
ORDER_SERVICE_URL=http://localhost
ORDER_SERVICE_PORT=8081

# --- Executor service (Spring Boot, services/executor) -----------------------
EXECUTOR_SERVICE_URL=http://localhost
EXECUTOR_SERVICE_PORT=8082
# How often the executor polls market data, in seconds
POLL_INTERVAL_SECONDS=60

# --- PostgreSQL: one database, two schemas (trade = orders side, auth = logins) -
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_system_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA_TRADE=trade
DB_SCHEMA_AUTH=auth

# --- JWT (the same secret and issuer must be set for auth, order and executor) -
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-rotate-before-any-shared-deployment-2026
JWT_ISSUER=auth-service
JWT_ALGORITHM=HS256
# Access token lifetime in seconds
JWT_EXPIRES_IN=900

# --- Kafka -------------------------------------------------------------------
# Address of the broker on the Docker network (docker-compose): host kafka, port 29092
KAFKA_HOST=kafka
KAFKA_PORT=29092
# Address the services use when they run directly on a machine (no Docker).
# A broker on the Linux VM: <vm-ip>:9092. A broker on this machine: localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Address the compose broker advertises to clients outside Docker
KAFKA_EXTERNAL_ADVERTISED=localhost:9092
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8086
MARKET_DATA_TOPIC=market-data
TRADE_EVENTS_TOPIC=trade-events
# One consumer group per module, never shared
KAFKA_WATCHLIST_GROUP=watchlist-service
KAFKA_NOTIFICATIONS_GROUP=notification-service
KAFKA_PORTFOLIO_GROUP=portfolio-service
MARKET_DATA_CONSUMER_ENABLED=true
NOTIFICATIONS_CONSUMER_ENABLED=true
PORTFOLIO_CONSUMER_ENABLED=true

# --- Fauxnance market data API ----------------------------------------------
FAUXNANCE_BASE_URL=https://y4t9nq2bqf.execute-api.eu-west-2.amazonaws.com/v1
FAUXNANCE_API_KEY=

# --- E-mail (SMTP): welcome mails from auth, notifications from order service --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SECURE=false

# --- In-app assistant (Gemini) ----------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-flash-latest

# --- Auth service extras -----------------------------------------------------
# Sign-in link put in the welcome e-mail (the web app's address)
APP_LOGIN_URL=http://localhost:4200
# Used only by `npm run create-admin` (services/auth_service); leave empty and pass it on the command line
ADMIN_PASSWORD=

# --- Order service tuning ----------------------------------------------------
AUTOMATION_ENABLED=true
# Demo button that places a REAL order from a scripted price path. Keep false outside demos.
AUTOMATION_SIMULATION=false
ALERTS_MAX_PER_ACCOUNT=25
FUNDS_MAX_PER_MOVEMENT=1000000
CANDLES_CACHE_SECONDS=60
PORTFOLIO_QUOTE_TTL_SECONDS=60
PORTFOLIO_STALE_AFTER_SECONDS=900
PORTFOLIO_PROVIDER_COOLDOWN_SECONDS=15
NOTIFICATIONS_DISPATCH_INTERVAL_MS=2000
ADVICE_SHORT_PERIOD=2
ADVICE_LONG_PERIOD=3

# --- SonarQube (optional, code quality scans) -------------------------------
SONAR_HOST_URL=http://sonarqube:9000
SONAR_TOKEN=

# Template for the Playwright journeys. Copy to .env (never committed), or export these in your shell.
# The browser goes through the dev server (E2E_BASE_URL); E2E_TRADE_API and E2E_AUTH_API are
# only used to check the real services are up before a journey starts.
E2E_BASE_URL=http://localhost:4200
E2E_TRADE_API=http://localhost:8081
E2E_AUTH_API=http://localhost:3000
E2E_USERNAME=john.doe
E2E_PASSWORD=
E2E_ACCOUNT_ID=
E2E_SYMBOL=AAPL

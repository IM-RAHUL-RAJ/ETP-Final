{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "set-env": "node scripts/set-env.mjs",
    "prestart": "node scripts/set-env.mjs",
    "start": "node scripts/start.mjs",
    "prebuild": "node scripts/set-env.mjs",
    "build": "ng build",
    "prewatch": "node scripts/set-env.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/set-env.mjs",
    "test": "ng test --watch=false",
    "generate:clients": "openapi-generator-cli generate",
    "e2e": "playwright test --workers=1",

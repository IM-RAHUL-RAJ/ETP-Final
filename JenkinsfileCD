pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
  }

  parameters {
    string(name: 'AWS_REGION', defaultValue: 'ap-south-1', description: 'AWS region')
    string(name: 'EKS_CLUSTER_NAME', defaultValue: 'capstone', description: 'Existing EKS cluster. This pipeline never creates a cluster.')
    string(name: 'RDS_HOST', defaultValue: 'database-1.c94cwk4g097q.ap-south-1.rds.amazonaws.com', description: 'RDS endpoint')
    string(name: 'RDS_PORT', defaultValue: '5432', description: 'RDS PostgreSQL port')
    string(name: 'RDS_DATABASE', defaultValue: 'trading_system_db', description: 'RDS database name')
    string(name: 'RDS_USER', defaultValue: 'postgres', description: 'RDS database user')
    string(name: 'IMAGE_TAG', defaultValue: '', description: 'Required tag produced by JenkinsfileCI')
    string(name: 'K8S_SECRETS_CREDENTIAL_ID', defaultValue: 'etp-k8s-secrets-env', description: 'Jenkins Secret file with DB_PASSWORD, JWT_SECRET, and FAUXNANCE_API_KEY')
    booleanParam(name: 'AUTO_AUTHORIZE_RDS', defaultValue: true, description: 'Only after RDS connectivity fails, authorize the EKS node security group on TCP 5432')
  }

  environment {
    AWS_REGION = 'ap-south-1'
    NS = 'tester'
    AUTH_REPO = 'trading-auth-service'
    ORDER_REPO = 'trading-trade-api'
    EXECUTOR_REPO = 'trading-executor'
    FRONTEND_REPO = 'trading-frontend'
  }

  stages {
    stage('Checkout SCM') {
      steps {
        checkout scm
        script {
          if (!params.IMAGE_TAG?.trim()) {
            error('IMAGE_TAG is required. Run JenkinsfileCI first and enter its printed tag.')
          }
          env.DB_HOST = params.RDS_HOST.trim()
          env.DB_PORT = params.RDS_PORT.trim()
          env.DB_NAME = params.RDS_DATABASE.trim()
          env.DB_USER = params.RDS_USER.trim()
        }
      }
    }

    stage('Validate existing cluster') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          command -v aws >/dev/null
          command -v kubectl >/dev/null
          aws eks describe-cluster --region "$AWS_REGION" --name "$EKS_CLUSTER_NAME" \
            --query 'cluster.status' --output text | grep -qx ACTIVE
          aws eks update-kubeconfig --region "$AWS_REGION" --name "$EKS_CLUSTER_NAME"
          kubectl get nodes -o wide
          kubectl get namespace "$NS" >/dev/null
        '''
      }
    }

    stage('Test RDS connectivity first') {
      steps {
        script {
          def status = sh(script: '''#!/usr/bin/env bash
            set +e
            kubectl run jenkins-rds-test -n "$NS" --rm -i --restart=Never \\
              --image=postgres:16 \\
              --env="DB_HOST=$DB_HOST" --env="DB_PORT=$DB_PORT" \\
              --env="DB_NAME=$DB_NAME" --env="DB_USER=$DB_USER" \\
              --command -- sh -c 'pg_isready -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME"'
            exit $?
          ''', returnStatus: true)
          env.RDS_TEST_FAILED = status == 0 ? 'false' : 'true'
          echo "RDS connectivity test failed: ${env.RDS_TEST_FAILED}"
        }
      }
    }

    stage('Authorize RDS after failed test') {
      when {
        allOf {
          expression { params.AUTO_AUTHORIZE_RDS }
          environment name: 'RDS_TEST_FAILED', value: 'true'
        }
      }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          NODEGROUP=$(aws eks list-nodegroups --region "$AWS_REGION" --cluster-name "$EKS_CLUSTER_NAME" --query 'nodegroups[0]' --output text)
          RDS_INSTANCE_ID=$(aws rds describe-db-instances --region "$AWS_REGION" \
            --query "DBInstances[?Endpoint.Address=='$DB_HOST'].DBInstanceIdentifier | [0]" --output text)
          test -n "$RDS_INSTANCE_ID" -a "$RDS_INSTANCE_ID" != None
          NODE_INSTANCE_ID=$(aws ec2 describe-instances --region "$AWS_REGION" \
            --filters "Name=tag:aws:eks:cluster-name,Values=$EKS_CLUSTER_NAME" \
                      "Name=tag:eks:nodegroup-name,Values=$NODEGROUP" \
                      "Name=instance-state-name,Values=running" \
            --query 'Reservations[].Instances[0].InstanceId | [0]' --output text)
          test -n "$NODE_INSTANCE_ID" -a "$NODE_INSTANCE_ID" != None
          RDS_SECURITY_GROUP_ID=$(aws rds describe-db-instances --region "$AWS_REGION" \
            --db-instance-identifier "$RDS_INSTANCE_ID" \
            --query 'DBInstances[0].VpcSecurityGroups[0].VpcSecurityGroupId' --output text)
          EKS_NODE_SECURITY_GROUP_ID=$(aws ec2 describe-instances --region "$AWS_REGION" \
            --instance-ids "$NODE_INSTANCE_ID" \
            --query 'Reservations[0].Instances[0].SecurityGroups[0].GroupId' --output text)
          aws ec2 authorize-security-group-ingress \
            --group-id "$RDS_SECURITY_GROUP_ID" --protocol tcp --port 5432 \
            --source-group "$EKS_NODE_SECURITY_GROUP_ID" || echo 'RDS ingress rule already exists.'
        '''
      }
    }

    stage('Retry RDS connectivity') {
      when { environment name: 'RDS_TEST_FAILED', value: 'true' }
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          kubectl run jenkins-rds-test -n "$NS" --rm -i --restart=Never \
            --image=postgres:16 \
            --env="DB_HOST=$DB_HOST" --env="DB_PORT=$DB_PORT" \
            --env="DB_NAME=$DB_NAME" --env="DB_USER=$DB_USER" \
            --command -- sh -c 'pg_isready -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME"'
        '''
      }
    }

    stage('Prepare ConfigMap and Secret') {
      steps {
        withCredentials([file(credentialsId: params.K8S_SECRETS_CREDENTIAL_ID, variable: 'K8S_SECRET_FILE')]) {
          sh '''#!/usr/bin/env bash
            set -euo pipefail
            sed -i -E "s#^  DB_HOST:.*#  DB_HOST: $DB_HOST#; s#^  DB_PORT:.*#  DB_PORT: \"$DB_PORT\"#; s#^  DB_NAME:.*#  DB_NAME: $DB_NAME#; s#^  DB_USER:.*#  DB_USER: $DB_USER#" k8s-tester/configmap.yaml
            awk -F= '$1 == "DB_PASSWORD" {print "db-password=" $2} $1 == "JWT_SECRET" {print "jwt-secret=" $2} $1 == "FAUXNANCE_API_KEY" {print "fauxnance-api-key=" $2}' "$K8S_SECRET_FILE" > /tmp/trading-secrets.env
            test -s /tmp/trading-secrets.env
            kubectl create secret generic trading-secrets -n "$NS" \
              --from-env-file=/tmp/trading-secrets.env \
              --dry-run=client -o yaml | kubectl apply -f -
            rm -f /tmp/trading-secrets.env
          '''
        }
      }
    }

    stage('Verify selected ECR images') {
      steps {
        script {
          env.AWS_ACCOUNT_ID = sh(script: 'aws sts get-caller-identity --query Account --output text', returnStdout: true).trim()
          env.REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${params.AWS_REGION}.amazonaws.com"
        }
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          for repo in "$AUTH_REPO" "$ORDER_REPO" "$EXECUTOR_REPO" "$FRONTEND_REPO"; do
            aws ecr describe-images --region "$AWS_REGION" --repository-name "$repo" --image-ids imageTag="$IMAGE_TAG" >/dev/null
          done
        '''
      }
    }

    stage('Apply ETP tester manifests') {
      steps {
        sh '''#!/usr/bin/env bash
          set -euo pipefail
          kubectl apply --dry-run=server -k k8s-tester/
          kubectl apply -k k8s-tester/
          kubectl -n "$NS" set image deployment/auth-service auth-service="$REGISTRY/$AUTH_REPO:$IMAGE_TAG"
          kubectl -n "$NS" set image deployment/order-service order-service="$REGISTRY/$ORDER_REPO:$IMAGE_TAG"
          kubectl -n "$NS" set image deployment/trade-executor trade-executor="$REGISTRY/$EXECUTOR_REPO:$IMAGE_TAG"
          kubectl -n "$NS" set image deployment/frontend frontend="$REGISTRY/$FRONTEND_REPO:$IMAGE_TAG"
          kubectl -n "$NS" rollout status deployment/auth-service --timeout=180s
          kubectl -n "$NS" rollout status deployment/order-service --timeout=180s
          kubectl -n "$NS" rollout status deployment/trade-executor --timeout=180s
          kubectl -n "$NS" rollout status deployment/frontend --timeout=180s
          kubectl -n "$NS" get pods -o wide
          kubectl -n "$NS" get services
        '''
      }
    }
  }

  post {
    always {
      sh 'rm -f /tmp/trading-secrets.env'
    }
  }
}
